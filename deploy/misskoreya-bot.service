# /etc/systemd/system/misskoreya-bot.service
# sudo systemctl daemon-reload && sudo systemctl enable --now misskoreya-bot

[Unit]
Description=Miss Koreya Telegram bot
After=network.target misskoreya-api.service
Wants=misskoreya-api.service

[Service]
Type=simple
User=misskoreya
Group=misskoreya
WorkingDirectory=/opt/misskoreya/bot
EnvironmentFile=/opt/misskoreya/backend/.env
ExecStart=/opt/misskoreya/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
