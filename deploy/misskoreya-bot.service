# /etc/systemd/system/misskoreya-bot.service
# sudo systemctl daemon-reload && sudo systemctl enable --now misskoreya-bot

[Unit]
Description=Miss Koreya Telegram bot
After=network.target misskoreya-api.service
Wants=misskoreya-api.service

[Service]
Type=simple
User=flipa
Group=flipa
WorkingDirectory=/home/flipa/apps/misskoreya/bot
EnvironmentFile=/home/flipa/apps/misskoreya/backend/.env
ExecStart=/home/flipa/apps/misskoreya/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
