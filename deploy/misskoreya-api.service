# /etc/systemd/system/misskoreya-api.service
# sudo systemctl daemon-reload && sudo systemctl enable --now misskoreya-api

[Unit]
Description=Miss Koreya FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=flipa
Group=flipa
WorkingDirectory=/home/flipa/apps/misskoreya/backend
EnvironmentFile=/home/flipa/apps/misskoreya/backend/.env
ExecStart=/home/flipa/apps/misskoreya/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
